# Copy to .env and fill in. Never commit .env — it is gitignored.

# development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3000

# --- Model providers -------------------------------------------------------
# At least one key is required. Set both to get automatic failover when the
# primary account runs out of credit.
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Which provider is tried first: anthropic | xai
LLM_PROVIDER=anthropic

# Comma-separated providers to fall back to when the primary cannot serve at
# all — exhausted credit, a rejected key, hard capacity. Leave empty to disable.
# Failover is deliberately narrow: a malformed request or a refusal never
# triggers it, so a bug fails loudly on one provider instead of billing two.
LLM_FALLBACK_PROVIDERS=xai

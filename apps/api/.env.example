# Copy to .env and fill in. Never commit .env — it is gitignored.

# development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3000

# --- Model providers -------------------------------------------------------
# At least one key is required. Set more than one to get automatic failover
# when the primary account runs out of credit.
#
# Note the two similarly-named-but-unrelated providers:
#   xAI   (x.ai)      -> Grok models.        Keys look like  xai-...
#   Groq  (groq.com)  -> open models, fast.  Keys look like  gsk_...
ANTHROPIC_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=

# Which provider is tried first: anthropic | groq | xai
LLM_PROVIDER=anthropic

# Comma-separated providers to fall back to when the primary cannot serve at
# all — exhausted credit, a rejected key. Leave empty to disable.
# Failover is deliberately narrow: a malformed request, a rate limit, or a
# refusal never triggers it. Rate limits are retried in place instead.
LLM_FALLBACK_PROVIDERS=groq,xai
